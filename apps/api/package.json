{
  "name": "@xplorio/api",
  "version": "0.0.0",
  "private": true,
  "description": "Xplorio API on Azure Functions (Node, TypeScript, v4 programming model).",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node build.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "func start",
    "dev": "tsx watch src/dev-server.ts"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/functions": "^4.17.0",
    "@azure/identity": "^4.14.0",
    "@xplorio/core": "workspace:*",
    "@xplorio/providers": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@xplorio/config": "workspace:*",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.0",
    "vitest": "^5.0.5"
  }
}
